# PISO Chain Environment Configuration

# Chain Metadata
CHAIN_NAME=PISO Chain
SYMBOL=PISO
DECIMALS=18
CHAIN_ID=2026001

# Network Ports
HTTP_RPC_PORT=8545
WS_RPC_PORT=8546
P2P_PORT=30303
EXPLORER_PORT=8080

# Local Endpoint URLs
RPC_URL=http://localhost:8545
WS_URL=ws://localhost:8546

# Public Subdomain Endpoint URLs
DOMAIN_NAME=piso-blockchain.vercel.app
PUBLIC_DASHBOARD_URL=https://piso-blockchain.vercel.app/
PUBLIC_RPC_URL=https://piso-rpc.loca.lt
PUBLIC_WS_URL=wss://piso-ws.loca.lt
PUBLIC_EXPLORER_URL=https://piso-explorer.loca.lt

# Validator & Genesis Configuration
VALIDATOR_ADDRESS=0x1821F246a27287a2187E1D634B8883030fA14731

# ─── Freqtrade Integration ───────────────────────────────────────────────────

# Freqtrade REST API credentials
FREQTRADE_API_USER=pisobot
FREQTRADE_API_PASSWORD=changeme
FREQTRADE_API_URL=http://localhost:8180

# Exchange API keys (leave blank for dry-run / paper trading)
EXCHANGE_KEY=
EXCHANGE_SECRET=

# Optional: Telegram bot for freqtrade trade alerts
FREQTRADE_BOT_TOKEN=
FREQTRADE_CHAT_ID=

# PISO Chain: jcode agent worker wallet private key (for on-chain proof submission)
WORKER_PRIVATE_KEY=

# Deployed PISOFreqtradeOracle.sol contract address (set after deployment)
FREQTRADE_ORACLE_ADDRESS=

# Bridge poll interval in seconds (default: 30)
FREQTRADE_POLL_INTERVAL=30
