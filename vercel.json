{
  "version": 2,
  "name": "piso-blockchain",
  "builds": [
    { "src": "dashboard/**", "use": "@vercel/static" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/.well-known/(.*)", "dest": "/dashboard/.well-known/$1" },
    { "src": "/(.*).apk", "dest": "/dashboard/$1.apk" },
    { "src": "/pow.html", "dest": "/dashboard/pow.html" },
    { "src": "/pow", "dest": "/dashboard/pow.html" },
    { "src": "/sakura.html", "dest": "/dashboard/sakura.html" },
    { "src": "/sakura", "dest": "/dashboard/sakura.html" },
    { "src": "/enterprise.html", "dest": "/dashboard/enterprise.html" },
    { "src": "/enterprise", "dest": "/dashboard/enterprise.html" },
    { "src": "/features.html", "dest": "/dashboard/features.html" },
    { "src": "/features", "dest": "/dashboard/features.html" },
    { "src": "/swap.html", "dest": "/dashboard/swap.html" },
    { "src": "/swap", "dest": "/dashboard/swap.html" },
    { "src": "/bridge.html", "dest": "/dashboard/bridge.html" },
    { "src": "/bridge", "dest": "/dashboard/bridge.html" },
    { "src": "/freqtrade.html", "dest": "/dashboard/freqtrade.html" },
    { "src": "/freqtrade", "dest": "/dashboard/freqtrade.html" },
    { "src": "/wallet.html", "dest": "/dashboard/wallet.html" },
    { "src": "/wallet", "dest": "/dashboard/wallet.html" },
    { "src": "/contracts.html", "dest": "/dashboard/contracts.html" },
    { "src": "/contracts", "dest": "/dashboard/contracts.html" },
    { "src": "/index.html", "dest": "/dashboard/index.html" },
    { "src": "/", "dest": "/dashboard/index.html" },
    { "src": "/(.*)", "dest": "/dashboard/$1" }
  ]
}
